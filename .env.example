# YardGuard 백엔드 환경변수 예시
# 사용법: 저장소 루트에서  cp .env.example .env
# 실제 비밀값(API 키 등)은 .env에만 넣고 저장소에 커밋하지 마십시오.
# 값은 backend/app/core/config.py 의 Settings 필드와 1:1로 대응합니다.

APP_NAME=YardGuard API

# 비우면 저장소 루트의 yardguard.db(SQLite)를 사용합니다.
# PostgreSQL 예: postgresql+psycopg://user:password@localhost:5432/yardguard
DATABASE_URL=

# 합성 데이터 디렉터리. 비우면 저장소 루트의 data 를 사용합니다.
DATA_DIR=

# 프런트엔드 오리진(쉼표 구분)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM 자연어 구조화 설정.
# LLM_PROVIDER 와 LLM_API_KEY 가 모두 채워졌을 때만 실제 공급자를 호출하고,
# 비어 있으면 결정론적 모의 어댑터를 사용합니다(키 없이 전체 시연 가능).
# 지원 공급자: anthropic, openai
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_TIMEOUT_SECONDS=20

# 업로드·입력 제한
MAX_CSV_BYTES=2097152
MAX_CSV_ROWS=1000
MAX_DESCRIPTION_LENGTH=2000
